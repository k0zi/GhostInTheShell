<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>GhostInTheShell</AssemblyName>
        <RootNamespace>GhostInTheShell.App</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="KD.Avalonia.Rice" Version="26.10.32" />
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    </ItemGroup>
    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="GhostInTheShell.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\GhostInTheShell.Core\GhostInTheShell.Core.csproj" />
        <ProjectReference Include="..\GhostInTheShell.Podman\GhostInTheShell.Podman.csproj" />
    </ItemGroup>
    <!-- Every agent and development environment is a plugin; ship them in plugins/ next to the app. -->
    <Import Project="..\Plugins\BundledPlugins.targets" />
</Project>
