<sukiUi:SukiWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                   xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                   xmlns:vm="using:GhostInTheShell.App.ViewModels"
                   xmlns:l="using:GhostInTheShell.App.Localization"
                   x:Class="GhostInTheShell.App.Views.MainWindow"
                   x:DataType="vm:MainWindowViewModel"
                   Title="Ghost in the Shell"
                   Width="1100" Height="720" MinWidth="640" MinHeight="420">

    <sukiUi:SukiWindow.LogoContent>
        <mi:MaterialIcon Kind="Ghost" Width="20" Height="20" />
    </sukiUi:SukiWindow.LogoContent>

    <sukiUi:SukiWindow.RightWindowTitleBarControls>
        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding BackendText}" VerticalAlignment="Center" Opacity="0.6" FontSize="12" Margin="0 0 8 0" />
            <Button Classes="Basic" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{l:Tr ToggleTheme}">
                <mi:MaterialIcon Kind="ThemeLightDark" />
            </Button>
            <Button Classes="Basic" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{l:Tr Settings}">
                <mi:MaterialIcon Kind="Cog" />
            </Button>
        </StackPanel>
    </sukiUi:SukiWindow.RightWindowTitleBarControls>

    <sukiUi:SukiWindow.Hosts>
        <sukiUi:SukiToastHost Manager="{Binding ToastManager}" />
        <sukiUi:SukiDialogHost Manager="{Binding DialogManager}" />
    </sukiUi:SukiWindow.Hosts>

    <DockPanel Margin="24 16 24 24">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0 0 0 16">
            <StackPanel Spacing="2">
                <TextBlock Text="{l:Tr Machines}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{l:Tr AppSubtitle}" Opacity="0.6" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="Basic" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:Tr Refresh}">
                    <mi:MaterialIcon Kind="Refresh" />
                </Button>
                <Button Classes="Flat" Command="{Binding NewMachineCommand}" IsEnabled="{Binding BackendError, Converter={x:Static ObjectConverters.IsNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Plus" />
                        <TextBlock Text="{l:Tr NewMachine}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <sukiUi:InfoBar DockPanel.Dock="Top" Margin="0 0 0 12" Severity="Error" IsClosable="False"
                        Title="{l:Tr BackendUnavailable}" Message="{Binding BackendError}"
                        IsVisible="{Binding BackendError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <sukiUi:InfoBar DockPanel.Dock="Top" Margin="0 0 0 12" Severity="Warning" IsClosable="True"
                        Title="{l:Tr Note}" Message="{Binding BackendWarning}"
                        IsVisible="{Binding BackendWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Panel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding IsEmpty}">
                <mi:MaterialIcon Kind="GhostOffOutline" Width="56" Height="56" Opacity="0.4" />
                <TextBlock Text="{l:Tr NoMachines}" HorizontalAlignment="Center" Opacity="0.7" />
                <Button Classes="Flat" Content="{l:Tr CreateFirstMachine}" HorizontalAlignment="Center" Command="{Binding NewMachineCommand}" />
            </StackPanel>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Machines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MachineViewModel">
                            <sukiUi:GlassCard Padding="16" DoubleTapped="Card_DoubleTapped">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- State dot -->
                                        <Ellipse Width="12" Height="12" Margin="0 0 12 0" VerticalAlignment="Center"
                                                 Classes.running="{Binding IsRunning}"
                                                 Classes.stopped="{Binding IsStopped}"
                                                 Classes.creating="{Binding IsCreating}"
                                                 Classes.failed="{Binding IsFailed}" />

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StateText}" Opacity="0.7" VerticalAlignment="Center" />
                                                <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center"
                                                             IsVisible="{Binding IsCreating}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <mi:MaterialIcon Kind="Linux" Opacity="0.7" />
                                                    <TextBlock Text="{Binding OsName}" Opacity="0.8" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <mi:MaterialIcon Kind="Account" Opacity="0.7" />
                                                    <TextBlock Text="{Binding UserName}" Opacity="0.8" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <mi:MaterialIcon Kind="Memory" Opacity="0.7" />
                                                    <TextBlock Text="{Binding ResourcesText}" Opacity="0.8" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding UsageText}" Opacity="0.8"
                                                           Classes.over="{Binding IsOverDiskLimit}"
                                                           IsVisible="{Binding UsageText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding AgentNames}" IsVisible="{Binding HasAgents}" Margin="0 2 0 0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Classes="badge">
                                                            <TextBlock Text="{Binding}" FontSize="12" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding ToolchainNames}" IsVisible="{Binding HasToolchains}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Classes="badge toolchain">
                                                            <TextBlock Text="{Binding}" FontSize="12" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Classes="Basic" ToolTip.Tip="{l:Tr OpenTerminal}"
                                                    IsVisible="{Binding !IsCreating}" IsEnabled="{Binding CanOpenTerminal}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenTerminalCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Console" />
                                            </Button>
                                            <Button Classes="Basic" ToolTip.Tip="{l:Tr Start}"
                                                    IsVisible="{Binding CanStart}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).StartCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Play" />
                                            </Button>
                                            <Button Classes="Basic" ToolTip.Tip="{l:Tr Stop}"
                                                    IsVisible="{Binding IsRunning}" IsEnabled="{Binding CanStop}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).StopCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Stop" />
                                            </Button>
                                            <Button Classes="Basic" ToolTip.Tip="{l:Tr Log}"
                                                    IsVisible="{Binding State, Converter={x:Static vm:Converters.IsCreatingState}}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ToggleLogCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="TextBoxOutline" />
                                            </Button>
                                            <Button Classes="Basic" ToolTip.Tip="{l:Tr Abort}"
                                                    IsVisible="{Binding IsCreating}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CancelCreateCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Cancel" />
                                            </Button>
                                            <Button Classes="Basic" ToolTip.Tip="{l:Tr Dismiss}"
                                                    IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DismissCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Close" />
                                            </Button>
                                            <Button Classes="Basic Danger" ToolTip.Tip="{l:Tr Delete}"
                                                    IsVisible="{Binding !IsCreating}" IsEnabled="{Binding CanDelete}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DeleteCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="Delete" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <TextBox Classes="log" IsReadOnly="True" Text="{Binding Log}"
                                             IsVisible="{Binding IsLogVisible}"
                                             TextChanged="Log_TextChanged" />
                                </StackPanel>
                            </sukiUi:GlassCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>

    <sukiUi:SukiWindow.Styles>
        <Style Selector="Ellipse">
            <Setter Property="Fill" Value="Gray" />
        </Style>
        <Style Selector="Ellipse.running">
            <Setter Property="Fill" Value="#22C55E" />
        </Style>
        <Style Selector="Ellipse.creating">
            <Setter Property="Fill" Value="#3B82F6" />
        </Style>
        <Style Selector="Ellipse.failed">
            <Setter Property="Fill" Value="#EF4444" />
        </Style>
        <Style Selector="TextBlock.over">
            <Setter Property="Foreground" Value="#EF4444" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor25}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8 2" />
            <Setter Property="Margin" Value="0 0 6 0" />
        </Style>
        <Style Selector="Border.badge.toolchain">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor75}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.log">
            <Setter Property="FontFamily" Value="monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="220" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="AcceptsReturn" Value="True" />
        </Style>
    </sukiUi:SukiWindow.Styles>
</sukiUi:SukiWindow>
