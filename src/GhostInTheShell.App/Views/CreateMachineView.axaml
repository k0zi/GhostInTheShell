<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GhostInTheShell.App.ViewModels"
             xmlns:catalog="using:GhostInTheShell.Core.Catalog"
             xmlns:l="using:GhostInTheShell.App.Localization"
             x:Class="GhostInTheShell.App.Views.CreateMachineView"
             x:DataType="vm:CreateMachineViewModel"
             Width="680">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0 12 0 0">
            <TextBlock Text="{Binding ErrorText}" Foreground="#EF4444" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="{l:Tr Cancel}" Command="{Binding CancelCommand}" />
                <Button Classes="Flat" Content="{l:Tr Create}" Command="{Binding CreateCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>

        <!-- MaxHeight follows the window (code-behind) so a short window scrolls instead of clipping. -->
        <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab}" Padding="0 12 0 0">
            <TabItem Header="{l:Tr TabMachine}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="0 0 12 0">
                <Grid ColumnDefinitions="*,24,*">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{l:Tr Name}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Name}" PlaceholderText="{l:Tr NamePlaceholder}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{l:Tr OperatingSystem}" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding OperatingSystems}" SelectedItem="{Binding SelectedOs}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="catalog:OsDefinition">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,24,*,24,*">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{l:Tr CpuCores}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Cpus, StringFormat='{}{0:0}'}" />
                        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="1" Maximum="{Binding MaxCpus}"
                                Value="{Binding Cpus}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </Grid>
                    <Grid Grid.Column="2" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{l:Tr Memory}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding MemoryGb, StringFormat='{}{0:0} GB'}" />
                        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="1" Maximum="{Binding MaxMemoryGb}"
                                Value="{Binding MemoryGb}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </Grid>
                    <Grid Grid.Column="4" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{l:Tr Disk}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding DiskGb, StringFormat='{}{0:0} GB'}" />
                        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="5" Maximum="{Binding MaxDiskGb}"
                                Value="{Binding DiskGb}" TickFrequency="5" IsSnapToTickEnabled="True" />
                    </Grid>
                </Grid>

                <Grid ColumnDefinitions="*,24,*">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:Tr CodingAgents}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Agents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AgentOption">
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSupported}" Margin="0 2"
                                              ToolTip.Tip="{l:Tr NotAvailableOnOs}"
                                              ToolTip.ServiceEnabled="{Binding !IsSupported}"
                                              ToolTip.ShowOnDisabled="True">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Definition.DisplayName}" />
                                            <TextBlock Text="{Binding Definition.Description}" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="{l:Tr DevEnvironments}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Toolchains}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToolchainOption">
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSupported}" Margin="0 2"
                                              ToolTip.Tip="{l:Tr NotAvailableOnOs}"
                                              ToolTip.ServiceEnabled="{Binding !IsSupported}"
                                              ToolTip.ShowOnDisabled="True">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Definition.DisplayName}" />
                                            <TextBlock Text="{Binding Definition.Description}" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
            </TabItem>

            <TabItem Header="{l:Tr TabUserAccount}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18" Margin="0 0 12 0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{l:Tr UserName}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding UserName}" />
                            <TextBlock Classes="hint" Text="{l:Tr UserNameHint}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <TextBlock Text="{l:Tr Password}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="{l:Tr ConfirmPassword}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Text="{Binding UserPassword}" PasswordChar="•" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding UserPasswordConfirm}" PasswordChar="•" />
                            </Grid>
                            <TextBlock Classes="hint" Text="{l:Tr UserPasswordHint}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <TextBlock Text="{l:Tr AdminPassword}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="{l:Tr ConfirmPassword}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Text="{Binding AdminPassword}" PasswordChar="•" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding AdminPasswordConfirm}" PasswordChar="•" />
                            </Grid>
                            <TextBlock Classes="hint" Text="{l:Tr AdminPasswordHint}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{l:Tr TabSharedFolder}">
                <StackPanel Spacing="4" Margin="0 0 12 0">
                    <TextBlock Text="{l:Tr HostFolder}" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,8,Auto">
                        <TextBox Text="{Binding HostFolder}" PlaceholderText="{l:Tr HostFolderPlaceholder}" FontFamily="monospace" />
                        <Button Grid.Column="2" Content="{l:Tr Browse}" Click="Browse_Click" />
                    </Grid>
                    <TextBlock Classes="hint" Text="{l:Tr HostFolderHint}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>

    <UserControl.Styles>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
</UserControl>
