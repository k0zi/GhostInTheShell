<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rice="clr-namespace:KD.Avalonia.Rice;assembly=KD.Avalonia.Rice"
             xmlns:local="using:GhostInTheShell.App"
             x:Class="GhostInTheShell.App.App">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!-- Includes FluentTheme and the Material icon styles. -->
        <rice:RiceStyles />

        <!-- Flat icon button; the hover color comes from Fluent. -->
        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="Button.subtle:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Destructive action. -->
        <Style Selector="Button.danger:not(.subtle)">
            <Setter Property="Background" Value="{DynamicResource RiceDangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource RiceDangerForegroundBrush}" />
        </Style>
        <Style Selector="Button.danger:not(.subtle):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger:not(.subtle):pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RiceDangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource RiceDangerForegroundBrush}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.subtle.danger">
            <Setter Property="Foreground" Value="{DynamicResource RiceDangerBrush}" />
        </Style>
        <Style Selector="Button.subtle.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource RiceDangerBrush}" />
        </Style>
    </Application.Styles>
</Application>
