<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GhostInTheShell.Core\GhostInTheShell.Core.csproj" />
    <ProjectReference Include="..\..\src\GhostInTheShell.Podman\GhostInTheShell.Podman.csproj" />
    <ProjectReference Include="..\..\src\GhostInTheShell.App\GhostInTheShell.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built, not referenced: the plugin tests load it the way the app does, from a plugins folder. -->
    <ProjectReference Include="..\..\samples\GhostInTheShell.SamplePlugin\GhostInTheShell.SamplePlugin.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <!-- The bundled plugins land in plugins/, as next to the app. -->
  <Import Project="..\..\src\Plugins\BundledPlugins.targets" />
  <Target Name="CopySamplePlugin" AfterTargets="Build">
    <MSBuild Projects="..\..\samples\GhostInTheShell.SamplePlugin\GhostInTheShell.SamplePlugin.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="SamplePluginAssembly" />
    </MSBuild>
    <PropertyGroup>
      <SamplePluginDir>@(SamplePluginAssembly->'%(RootDir)%(Directory)')</SamplePluginDir>
    </PropertyGroup>
    <ItemGroup>
      <SamplePluginFiles Include="$(SamplePluginDir)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(SamplePluginFiles)" DestinationFolder="$(OutDir)sample-plugins/GhostInTheShell.SamplePlugin" SkipUnchangedFiles="true" />
  </Target>
</Project>
